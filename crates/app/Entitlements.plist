<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The macOS build is signed with the hardened runtime (needed for
  notarization), which forbids generating machine code at run time unless
  entitled. Magnitide plugins are WebAssembly that wasmtime compiles
  (Cranelift) when they load, into memory it then makes executable: without
  these, every Magnitide plugin fails in a signed build and works in dev.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
</dict>
</plist>
