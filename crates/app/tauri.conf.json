{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Magnitide",
  "identifier": "com.magnitide.app",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "ui/dist",
    "beforeDevCommand": { "script": "pnpm dev", "cwd": "ui" },
    "beforeBuildCommand": { "script": "pnpm build", "cwd": "ui" }
  },
  "app": {
    "windows": [
      {
        "title": "Magnitide",
        "width": 1280,
        "height": 820,
        "minWidth": 640,
        "minHeight": 440,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 24 }
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' cover: http://cover.localhost page: http://page.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "linux": {
      "deb": { "desktopTemplate": "linux/magnitide.desktop" },
      "rpm": { "desktopTemplate": "linux/magnitide.desktop" }
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "Entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/Assets.car",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENCQUIzM0VFNTdBMTE5NUYKUldSZkdhRlg3ak9yeTlLUFphSUkvYVgwYS9acURuWXB1QzNoK25BMTZ3RGM5OGlxVkMvaWN2R0gK",
      "endpoints": ["https://github.com/obscuredetour/magnitide/releases/latest/download/latest.json"]
    }
  }
}
