{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Magnitide",
  "version": "0.1.0",
  "identifier": "dev.magnitide.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Magnitide",
        "width": 1280,
        "height": 820,
        "minWidth": 640,
        "minHeight": 440,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' cover: http://cover.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png"]
  }
}
