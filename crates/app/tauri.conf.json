{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Magnitide",
  "version": "0.2.0",
  "identifier": "dev.magnitide.app",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "ui/dist",
    "beforeDevCommand": { "script": "pnpm dev", "cwd": "ui" },
    "beforeBuildCommand": { "script": "pnpm build", "cwd": "ui" }
  },
  "app": {
    "windows": [
      {
        "title": "Magnitide",
        "width": 1280,
        "height": 820,
        "minWidth": 640,
        "minHeight": 440,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' cover: http://cover.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
